<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Vesper</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#101010</string>
        <key>foreground</key><string>#FFFFFF</string>
        <key>caret</key><string>#FFC799</string>
        <key>selection</key><string>#232323</string>
        <key>lineHighlight</key><string>#161616</string>
        <key>gutterForeground</key><string>#707070</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#707070</string><key>fontStyle</key><string>italic</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, storage.type, storage.modifier, keyword.operator</string>
      <key>settings</key><dict><key>foreground</key><string>#A0A0A0</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, constant.other.symbol, constant.other.key</string>
      <key>settings</key><dict><key>foreground</key><string>#99FFE4</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, variable.function, support.function</string>
      <key>settings</key><dict><key>foreground</key><string>#FFC799</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>entity.name.type, support.type, support.class, entity.name.tag</string>
      <key>settings</key><dict><key>foreground</key><string>#FFC799</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character</string>
      <key>settings</key><dict><key>foreground</key><string>#FFC799</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, meta.definition.variable</string>
      <key>settings</key><dict><key>foreground</key><string>#FFFFFF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Attribute</string>
      <key>scope</key><string>entity.other.attribute-name</string>
      <key>settings</key><dict><key>foreground</key><string>#FFC799</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, markup.deleted</string>
      <key>settings</key><dict><key>foreground</key><string>#FF8080</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#99FFE4</string></dict>
    </dict>
  </array>
</dict>
</plist>
