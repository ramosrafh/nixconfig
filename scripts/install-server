#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "Erro: $*" >&2
  exit 1
}

nix_live() {
  command nix --extra-experimental-features "nix-command flakes" "$@"
}

[[ ${EUID} -eq 0 ]] || die "execute como root"
[[ $# -eq 2 ]] || die "uso: bash scripts/install-server <disco> <chave-publica-ssh>"
[[ -d /sys/firmware/efi/efivars ]] || die "o live USB não iniciou em modo UEFI"

DISK=$1
SSH_KEY=$(realpath "$2")
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO=$(realpath "$SCRIPT_DIR/..")
TARGET=/mnt/server-install
INSTALL_USER=$(nix_live eval --raw "path:$REPO#lib.primaryUser")

[[ -b "$DISK" ]] || die "disco inexistente: $DISK"
[[ -f "$SSH_KEY" ]] || die "chave pública inexistente: $SSH_KEY"
read -r SSH_KEY_TYPE _ < "$SSH_KEY" || die "não foi possível ler a chave pública"
case "$SSH_KEY_TYPE" in
  ssh-* | ecdsa-* | sk-*) ;;
  *) die "use uma chave SSH pública, nunca a chave privada" ;;
esac
ssh-keygen -l -f "$SSH_KEY" >/dev/null || die "arquivo de chave pública inválido"

REAL_DISK=$(readlink -f "$DISK")
[[ $(lsblk -dn -o TYPE "$REAL_DISK") == "disk" ]] || die "$DISK não representa um disco inteiro"
mountpoint -q "$TARGET" && die "$TARGET já está montado"
cryptsetup status cryptroot >/dev/null 2>&1 && die "o mapper cryptroot já está aberto"

cleanup() {
  mountpoint -q "$TARGET" && umount -R "$TARGET" || true
  cryptsetup status cryptroot >/dev/null 2>&1 && cryptsetup close cryptroot || true
}
trap cleanup EXIT

echo "Disco selecionado:"
lsblk -o NAME,PATH,SIZE,MODEL,SERIAL,TYPE,FSTYPE,MOUNTPOINTS "$REAL_DISK"
echo
echo "ATENÇÃO: todos os dados de $DISK serão apagados."
read -r -p "Digite exatamente $DISK para continuar: " CONFIRM
[[ "$CONFIRM" == "$DISK" ]] || die "confirmação incorreta"

if [[ ! -f /var/lib/sbctl/keys/db/db.key ]]; then
  nix_live shell "path:$REPO#sbctl" -c sbctl create-keys
fi

[[ -f /var/lib/sbctl/keys/db/db.key ]] || die "chave do Secure Boot não foi criada"

nix_live run "path:$REPO#disko-install" -- \
  --write-efi-boot-entries \
  --flake "path:$REPO#server" \
  --disk main "$REAL_DISK" \
  --mount-point "$TARGET" \
  --extra-files /var/lib/sbctl /var/lib/sbctl \
  --extra-files "$REPO" "/home/$INSTALL_USER/nixconfig"

# disko-install unmounts the target after a successful installation. Mount the
# subvolumes required by nixos-enter before configuring the installed user.
CRYPT_PARTITION=$(lsblk -nrpo PATH,PARTLABEL "$REAL_DISK" | awk '$2 == "cryptroot" { print $1; exit }')
[[ -n "$CRYPT_PARTITION" && -b "$CRYPT_PARTITION" ]] || die "partição cryptroot não encontrada em $REAL_DISK"

if ! cryptsetup status cryptroot >/dev/null 2>&1; then
  echo "Abra novamente o LUKS para concluir a configuração do usuário."
  cryptsetup open "$CRYPT_PARTITION" cryptroot
fi

install -d "$TARGET"
mountpoint -q "$TARGET" || \
  mount -o subvol=@,compress=zstd,noatime /dev/mapper/cryptroot "$TARGET"
install -d "$TARGET/home" "$TARGET/nix"
mountpoint -q "$TARGET/home" || \
  mount -o subvol=@home,compress=zstd,noatime /dev/mapper/cryptroot "$TARGET/home"
mountpoint -q "$TARGET/nix" || \
  mount -o subvol=@nix,compress=zstd,noatime /dev/mapper/cryptroot "$TARGET/nix"

install -d -m 0700 "$TARGET/home/$INSTALL_USER/.ssh"
install -m 0600 "$SSH_KEY" "$TARGET/home/$INSTALL_USER/.ssh/authorized_keys"
nixos-enter --root "$TARGET" -c "chown -R '$INSTALL_USER':users '/home/$INSTALL_USER'"

echo "Defina a senha local/sudo de $INSTALL_USER."
nixos-enter --root "$TARGET" -c "passwd '$INSTALL_USER'"

sync
cleanup
trap - EXIT

echo "Instalação concluída. Reinicie e retire o live USB."
echo "No primeiro boot, entre pelo console, execute 'sudo netbird up' e depois ative Secure Boot/TPM2."
