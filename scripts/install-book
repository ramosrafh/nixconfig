#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "Erro: $*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "execute como root"
[[ $# -eq 1 ]] || die "uso: bash scripts/install-book <disco>"
[[ -d /sys/firmware/efi/efivars ]] || die "o live USB não iniciou em modo UEFI"

DISK=$1
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO=$(realpath "$SCRIPT_DIR/..")
TARGET=/mnt/book-install
INSTALL_USER=$(nix eval --raw "$REPO#primaryUser")

[[ -b "$DISK" ]] || die "disco inexistente: $DISK"
REAL_DISK=$(readlink -f "$DISK")
[[ $(lsblk -dn -o TYPE "$REAL_DISK") == "disk" ]] || \
  die "$DISK não representa um disco inteiro"

mountpoint -q "$TARGET" && die "$TARGET já está montado; desmonte-o antes de continuar"
cryptsetup status cryptroot >/dev/null 2>&1 && die "o mapper cryptroot já está aberto"

cleanup() {
  if mountpoint -q "$TARGET"; then
    umount -R "$TARGET" || true
  fi
  if cryptsetup status cryptroot >/dev/null 2>&1; then
    cryptsetup close cryptroot || true
  fi
}
trap cleanup EXIT

echo "Disco selecionado:"
lsblk -o NAME,PATH,SIZE,MODEL,SERIAL,TYPE,FSTYPE,MOUNTPOINTS "$REAL_DISK"
echo
echo "ATENÇÃO: todos os dados de $DISK serão apagados."
read -r -p "Digite exatamente $DISK para continuar: " CONFIRM
[[ "$CONFIRM" == "$DISK" ]] || die "confirmação incorreta"

if [[ ! -f /var/lib/sbctl/keys/db/db.key ]]; then
  echo "Criando as chaves do Secure Boot no live USB..."
  nix shell "$REPO#sbctl" -c sbctl create-keys
fi

[[ -f /var/lib/sbctl/keys/db/db.key ]] || die "chave privada do Secure Boot não foi criada"
[[ -f /var/lib/sbctl/keys/db/db.pem ]] || die "certificado do Secure Boot não foi criado"

echo "Iniciando a instalação destrutiva com Disko..."
nix run "$REPO#disko-install" -- \
  --write-efi-boot-entries \
  --flake "$REPO#book" \
  --disk main "$DISK" \
  --extra-files /var/lib/sbctl /var/lib/sbctl \
  --extra-files "$REPO" "/home/$INSTALL_USER/nixconfig"

if ! cryptsetup status cryptroot >/dev/null 2>&1; then
  cryptsetup open /dev/disk/by-partlabel/cryptroot cryptroot
fi

mkdir -p "$TARGET"
mount -o subvol=@ /dev/mapper/cryptroot "$TARGET"
mount --mkdir -o subvol=@nix /dev/mapper/cryptroot "$TARGET/nix"
mount --mkdir -o subvol=@home /dev/mapper/cryptroot "$TARGET/home"

nixos-enter --root "$TARGET" -c "id '$INSTALL_USER' >/dev/null" || \
  die "o usuário $INSTALL_USER não existe na configuração NixOS"

echo "Defina agora a senha do usuário $INSTALL_USER."
nixos-enter --root "$TARGET" -c "passwd '$INSTALL_USER'"
nixos-enter --root "$TARGET" -c \
  "chown -R '$INSTALL_USER':users '/home/$INSTALL_USER'"

sync
cleanup
trap - EXIT

echo
echo "Instalação concluída. Execute reboot e retire o live USB."
echo "O primeiro boot ainda solicitará a senha LUKS."
